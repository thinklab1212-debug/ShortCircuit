PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5174

# Billing Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.9biub.mongodb.net/billing_db?retryWrites=true&w=majority&appName=Cluster0

# Store MongoDB Database (Read-only source to sync catalog from)
STORE_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.w1rymsd.mongodb.net/?appName=Cluster0

# Cloudinary (Optional - for remote invoice PDF hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=billing_invoices

# Resend Email Service
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Short Circuit <sales.shortcircuit@gmail.com>

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
ADMIN_DEFAULT_EMAIL=admin@shortcircuit.in
ADMIN_DEFAULT_PASSWORD=your_secure_password_here
